# Copied to .env by `npm run db:setup` if .env does not exist. Never commit .env.
# SQLite file, relative to the repository root.
DATABASE_URL="file:./dev.db"
# The demo tools (D74, wave 3 review finding 6): the scenario-card Run buttons. "1" turns them
# on, "0" off; left out, they are on everywhere but a production build (`next start`).
DEMO_TOOLS="1"
# The audit log's signing key (D81): an Ed25519 private key, base64 PKCS#8. Left empty here on
# purpose: `npm run db:setup` (and `npm run dev`) generate one into .env, never into the repo.
# Changing it makes every row signed with the old key read as forged; run `npm run db:reset`.
AUDIT_SIGNING_KEY=""
# Where the audit anchors are kept, outside the database (D81). Empty: beside the SQLite file
# (dev.db.anchors.jsonl). Point it at another disk or a synced folder to protect more.
AUDIT_ANCHOR_FILE=""
# Sign-in (D91, D92, D95). The seed (`npm run db:setup`) adds an account for the admin on
# ADMIN_EMAIL and one per test customer on its e-mail in data/customers.json. People (consumers,
# sole traders) sign in with the Test Bank and have no password; CUSTOMER_PASSWORD is the
# companies' password. The passwords are left empty here on purpose: `npm run db:setup` (and
# `npm run dev`) generate random ones into .env, never into the repo. At least 12 characters.
ADMIN_EMAIL="admin@lease-loop.example"
ADMIN_PASSWORD=""
CUSTOMER_PASSWORD=""
# The key that links accounts to bank identities (D95): an HMAC key, so the database never holds
# a personal identity code or a plain hash of one. Generated into .env; changing it unlinks
# every person's account until the seed links them again (`npm run db:reset`).
IDENTITY_HASH_KEY=""
